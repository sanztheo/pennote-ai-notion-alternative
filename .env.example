# ─────────────────────────────────────────────────────────────────
# Pennote (root monorepo)
# This file is intentionally minimal — actual configuration lives
# in each submodule. Copy each submodule's .env.example separately:
#
#   cp pen-backend/.env.example pen-backend/.env
#   cp pen-frontend/.env.example pen-frontend/.env
#   cp pen-website/.env.example pen-website/.env.local
#
# This root .env is only used by ad-hoc scripts in scripts/.
# ─────────────────────────────────────────────────────────────────

# Optional. GitHub Personal Access Token used by scripts/ that interact with submodule repos.
# Required scopes: repo, workflow.
GITHUB_TOKEN=

# Optional. Set to "true" to enable verbose script output.
DEBUG=
